# ===========================================================================
# Environment template — copy to `.env` and adjust. Sections are grouped by the
# app that reads them (shared → api → worker → web → mobile). Commented lines are
# optional overrides; uncommented lines are the minimum for local development.
# Deeper behavior lives in source comments (e.g. `packages/db`, `packages/shared`).
# ===========================================================================

# ---------------------------------------------------------------------------
# Shared — read by API + worker (and web/mobile build where noted)
# ---------------------------------------------------------------------------
# `development` enables convenient defaults (e.g. AUTO_MIGRATE when unset). Use `production` when deployed.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (shared) — see `packages/db/src/database-url.ts` for full rules.
# `DATABASE_DIALECT`: `mysql` | `supabase` | default `postgres`. `supabase` reuses the Postgres schema.
# ---------------------------------------------------------------------------
DATABASE_DIALECT=postgres

# Local dev: compose the URL from these parts (DATABASE_PORT defaults by dialect: pg 5432 / mysql 3306).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=1
DATABASE_NAME=template

# Or provide a single URL (wins over the parts above; needed for IPv6, sslmode, hosted URLs).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starter

# Supabase (only when DATABASE_DIALECT=supabase): paste a ready URL, or compose from project ref + password.
# Host/port/user/db are derived from the project ref and pooler mode — no per-field overrides.
# SUPABASE_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_DB_REGION=eu-west-1                 # required for pooler modes; omit for `direct`
# SUPABASE_DB_POOLER=transaction               # transaction (default) | session | direct

# ---------------------------------------------------------------------------
# Queue & cache strategy (shared) — ONE switch for jobs + cache.
#   external  → BullMQ + Redis (REDIS_URL). Best for higher load / multi-node. (default)
#   local     → SQL-backed queue + cache (no Redis). Works with Postgres, Supabase, or MySQL.
#               Best for low load / single-node SQL hosts. Supabase: prefer session/direct pooler for job locking.
# Poll interval, retention, GC, and concurrency use sensible built-in defaults (see packages/shared).
# ---------------------------------------------------------------------------
QUEUE_STRATEGY=external
REDIS_URL=redis://localhost:6379
# Production: use rediss:// for TLS. Set REDIS_TLS=require to fail boot without TLS, or REDIS_TLS=false to opt out.
# REDIS_TLS=require

# Postgres TLS in production (Supabase dialect enables SSL automatically). Optional for self-hosted Postgres:
# DATABASE_SSL=require
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# ---------------------------------------------------------------------------
# Secrets (shared) — required in production (API refuses to start otherwise).
# ---------------------------------------------------------------------------
# At least 32 non-whitespace characters in production.
JWT_ACCESS_SECRET=replace-with-at-least-32-chars-secret
JWT_REFRESH_SECRET=replace-with-long-refresh-secret
# Base64-encoded 32-byte key for envelope field encryption (`packages/crypto`).
# Blind search indexes use an HKDF subkey derived from this same secret.
FIELD_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# ---------------------------------------------------------------------------
# API — `apps/api` (Fastify)
# ---------------------------------------------------------------------------
# Listen port. Vite dev proxy targets http://127.0.0.1:<API_PORT> when VITE_API_BASE_URL is unset.
# Hostinger / PaaS: if API_PORT is unset, the API falls back to platform PORT.
API_PORT=3500

# Worker health HTTP (optional locally). Hostinger injects PORT on the jobs Web App — that is enough.
# Prefer WORKER_PORT when you want an explicit local health port without colliding with the API.
# WORKER_PORT=3600

# CORS (`apps/api/src/lib/cors-config.ts`). Non-prod unset = reflect Origin. Production unset = cross-origin denied.
# CORS_ORIGINS=http://localhost:5173,https://app.example.com
# CORS_CREDENTIALS=true            # required for HttpOnly refresh cookies in production (exact origins; no `*`).
# CORS_ALLOWED_HEADERS=authorization,content-type,x-csrf-token
# REFRESH_TOKEN_IN_COOKIE=false      # opt out of HttpOnly refresh cookies (default: on in production, off in dev).
# COOKIE_SECURE=true               # force Secure cookies outside production when testing over HTTPS.
# LOGIN_LOCKOUT_MAX_FAILURES=10
# LOGIN_LOCKOUT_WINDOW_SECONDS=900

# Public origins for OAuth/redirects (default to localhost:<API_PORT> and localhost:5173).
# API_PUBLIC_ORIGIN=http://localhost:3500
# WEB_PUBLIC_ORIGIN=http://localhost:5173

# Response-header byte budget (some shared hosts hard-cap header size — keep headers lean). Default 8192.
# RESPONSE_HEADER_MAX_BYTES=8192
# Hostinger/LiteSpeed default: meta-only CSP (no CSP HTTP header). Opt out on other hosts:
# CSP_IN_META=off

# Blob storage (`apps/api/src/lib/blob-storage/`). Default: local disk (`apps/api/files`).
# BLOB_STORAGE_BACKEND=local
# ALLOW_LOCAL_BLOB_STORAGE=true    # acknowledge single-node local blob storage in production.
# ALLOW_PLAINTEXT_BLOB_STORAGE=true # allow plaintext uploads without FIELD_ENCRYPTION_KEY (local dev only).
# BLOB_STORAGE_BACKEND=s3          # S3-compatible (AWS, MinIO, R2, ...). Then set:
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=                     # custom endpoint (MinIO)
# S3_KEY_PREFIX=
# S3_FORCE_PATH_STYLE=true         # MinIO / some S3-compatible endpoints
# S3_SERVER_SIDE_ENCRYPTION=AES256 # or aws:kms (provider at-rest encryption on upload)
# S3_SSE_KMS_KEY_ID=               # when S3_SERVER_SIDE_ENCRYPTION=aws:kms

# Geocoding (super-admin Nominatim). Default host: nominatim.openstreetmap.org.
# NOMINATIM_ALLOWED_HOSTS=nominatim.openstreetmap.org,self-hosted.example
# NOMINATIM_CACHE_TTL_SECONDS=15552000   # geocode cache TTL (default ~180 days).

# HTTP rate limits — all optional; unset = defaults. Windows are milliseconds (min 1000).
# RATE_LIMIT_GLOBAL_MAX=100        RATE_LIMIT_GLOBAL_WINDOW=60000
# RATE_LIMIT_WEBHOOK_MAX=8000
# RATE_LIMIT_AUTH_MAX=40           RATE_LIMIT_AUTH_WINDOW=900000
# RATE_LIMIT_TENANT_MAX=300        RATE_LIMIT_TENANT_WINDOW=60000
# RATE_LIMIT_CRM_GEOCODE_MAX=60    RATE_LIMIT_CRM_GEOCODE_WINDOW=60000
# RATE_LIMIT_ACCOUNT_GEOCODE_MAX=60 RATE_LIMIT_ACCOUNT_GEOCODE_WINDOW=60000

# Dev/onboarding conveniences (non-production unless noted).
# DEV_ONLY_REGISTRATION_EXPOSE_VERIFICATION_CODE=true   # return verification code in JSON when SMTP is off (no effect in production).
# CORPORATE_FIRST_USER_ADMIN=true              # first verified @corp user becomes tenant_admin (demo/dev).
# ADMIN_PASSWORD_RESET_RETURN_PLAIN=true       # production emergency: return reset password in JSON.

# Migrations & bootstrap.
# AUTO_MIGRATE is ignored when NODE_ENV=development (migrations always run). Production: `off` or `force`.
# BOOTSTRAP_SUPER_ADMIN_EMAIL=ops@example.com  # one-time platform super-admin seed (idempotent).
# BOOTSTRAP_SUPER_ADMIN_PASSWORD=change-me-8-chars-min
# ALLOW_BOOTSTRAP_SUPER_ADMIN=true             # required for bootstrap in production.

# Mailbox OAuth (optional; IMAP works without these). Setup: docs/mailbox-module.md.
# Redirect URI: {API_PUBLIC_ORIGIN or http://localhost:<API_PORT>}/v1/tenant/mailbox/oauth/{google|microsoft}/callback
# MAILBOX_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# MAILBOX_GOOGLE_CLIENT_SECRET=GOCSPX-your-secret-here
# MAILBOX_MICROSOFT_CLIENT_ID=your-application-client-id
# MAILBOX_MICROSOFT_CLIENT_SECRET=your-client-secret
# MAILBOX_MICROSOFT_TENANT_ID=common

# ---------------------------------------------------------------------------
# Worker — `apps/worker`
# ---------------------------------------------------------------------------
# MAILBOX_SYNC_SCAN_INTERVAL_MS=300000         # mailbox sync scan cadence (default 5 minutes).

# ---------------------------------------------------------------------------
# Web SPA — `apps/web` (Vite; only VITE_* reach the browser bundle)
# ---------------------------------------------------------------------------
# In development leave unset so Vite proxies /v1, /webhooks, /health, etc. to the API.
# Set to the API origin ONLY (no /v1 suffix) when the API runs on another host.
# VITE_API_BASE_URL=http://localhost:3500
# VITE_REFRESH_TOKEN_IN_COOKIE=true            # match API REFRESH_TOKEN_IN_COOKIE.
# VITE_CSP_CONNECT_SRC_EXTRA=                  # extra connect-src hostnames (no scheme), comma-separated.
# VITE_CSP_IMG_SRC_EXTRA=                      # extra img-src hostnames.

# ---------------------------------------------------------------------------
# Mobile — `apps/mobile` (Expo; only EXPO_PUBLIC_* reach the app bundle)
# ---------------------------------------------------------------------------
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3500   # API origin only (no /v1); defaults to localhost:3500.

# ---------------------------------------------------------------------------
# Logging — API + worker (`packages/logger`, Pino)
# ---------------------------------------------------------------------------
# LOG_LEVEL=info        # trace | debug | info | warn | error | fatal | silent
# VERBOSE=true          # shorthand for debug when LOG_LEVEL is unset.
# LOG_PRETTY=false      # JSON lines only (default is pretty in non-production).
# LOG_HTTP=false        # disable Fastify per-request logs (API only).
