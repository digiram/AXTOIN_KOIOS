{
  "name": "@starter/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node ../../scripts/run-dev-registered.mjs @starter/api tsx watch src/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "node --test --import tsx \"./test/**/*.test.ts\" \"./test/integration/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi:sync": "tsx scripts/sync-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.0",
    "@starter/crypto": "workspace:*",
    "@starter/db": "workspace:*",
    "@starter/logger": "workspace:*",
    "@starter/shared": "workspace:*",
    "@types/nodemailer": "^8.0.1",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "fastify-raw-body": "5.0.0",
    "ioredis": "^5.11.1",
    "lucide-static": "^1.27.0",
    "mjml": "^5.4.0",
    "isomorphic-dompurify": "^3.20.0",
    "nodemailer": "^9.0.1",
    "otplib": "^13.4.1",
    "sharp": "^0.35.3",
    "stripe": "22.3.2",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/mjml": "^5.0.0",
    "tsx": "^4.22.4"
  }
}
