                        ]
                      },
                      "workLocation": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 512
                          },
                          {
                            "type": "string",
                            "enum": [
                              ""
                            ]
                          },
                          {
                            "enum": [
                              "null"
                            ],
                            "nullable": true
