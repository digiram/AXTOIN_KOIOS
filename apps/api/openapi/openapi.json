                          },
                          {
                            "type": "string",
                            "enum": [
                              ""
                            ]
                          },
                          {
                            "enum": [
                              "null"
                            ],
                            "nullable": true
                          }
                        ]
                      },
                      "workEmail": {
                        "anyOf": [
                          {
                            "type": "string",
