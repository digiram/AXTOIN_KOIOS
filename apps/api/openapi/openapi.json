    "/tenant/sales/bdr/leads": {
      "post": {
        "tags": [
          "Sales"
        ],
        "summary": "Create BDR lead",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/definitions/SalesFunnelBdrLeadCreate",
                "definitions": {
                  "SalesFunnelBdrLeadCreate": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255
                      },
                      "description": {
                        "type": "string",
                        "maxLength": 8000,
                        "default": ""
                      },
                      "stageKey": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "tags": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "maxItems": 20
                      },
                      "ownerUserId": {
                        "type": "string",
                        "format": "uuid",
                        "nullable": true
                      },
                      "crmOrganizationId": {
                        "type": "string",
                        "format": "uuid",
                        "nullable": true
                      },
                      "contactIds": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "maxItems": 50
                      },
                      "contacts": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "contactId": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "role": {
                              "type": "string",
                              "maxLength": 128,
                              "default": ""
                            }
                          },
                          "required": [
                            "contactId"
                          ],
                          "additionalProperties": false
                        },
                        "maxItems": 50
                      }
                    },
                    "required": [
                      "title"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created lead"
          }
        }
      }
    },
    "/tenant/workforce/employees": {
